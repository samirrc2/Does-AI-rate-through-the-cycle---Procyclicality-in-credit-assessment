{
  "paper": "Paper 5 \u2014 Does AI rate through the cycle?",
  "run": "bash reproduce.sh",
  "claims": "claims*.json",
  "artifacts": [
    "README.md",
    "claims.json",
    "claims_revision.json",
    "paper/src/tables/*.csv",
    "paper/src/tables/*.tex",
    "results/joint_spec.json",
    "results/ofat.json",
    "results/pd_retention_ci.json",
    "results/real_arm.json",
    "results/reviewer_revision.json",
    "results/revision_extras.json",
    "results/seeds_epochs.json",
    "results/synthetic_real_overlap.json",
    "results/tables/*.csv",
    "results/tables/*.tex"
  ],
  "inputs": [
    "data/raw/runs_*.csv",
    "data/frozen/*.freeze.json",
    "data/firms/full.jsonl",
    "data/firms/real.jsonl",
    "manifest/firms_manifest.json",
    "PREREGISTRATION.md"
  ],
  "notes": [
    "No capsule key: this paper is archived on Zenodo as a source release, not as a Code Ocean",
    "/code + /data mount, so there is nothing for a capsule track to emulate. con1 skips track B",
    "and says so; the clone track still answers the question that matters, which is whether a",
    "reader who clones the repository reproduces every number."
  ],
  "gates": [
    "sh paper/tools/with_py.sh paper/tools/bind_manuscript_numbers.py",
    "sh paper/tools/with_py.sh paper/tools/bind_letter_numbers.py",
    "sh paper/tools/with_py.sh paper/tools/verify_tables.py",
    "sh paper/tools/with_py.sh paper/tools/verify_locators.py",
    "sh paper/tools/with_py.sh paper/tools/verify_response_numbers.py",
    "sh paper/tools/with_py.sh paper/tools/check_readme.py"
  ]
}
